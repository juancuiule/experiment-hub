{
  "name": "@experiment-hub/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "PORT=3100 NODE_ENV=development tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:effect --external:'effect/*' --external:'@effect/*'",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "export:configs": "tsx scripts/export-configs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/sql-sqlite-node": "4.0.0-rc.117",
    "@experiment-hub/engine": "workspace:*",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.117",
    "esbuild": "^0.28.2",
    "@types/node": "^24",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
