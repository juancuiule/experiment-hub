{"edges":[{"from":"start","to":"screen-intro","type":"sequential"},{"from":"screen-intro","to":"path-questions","type":"sequential"},{"from":"path-questions","order":0,"to":"screen-energy-sleep-mood","type":"path-contains"},{"from":"path-questions","order":1,"to":"screen-mind-stress-body","type":"path-contains"},{"from":"path-questions","to":"screen-thanks","type":"sequential"},{"from":"screen-thanks","to":"end","type":"sequential"}],"nodes":[{"id":"start","type":"start"},{"id":"screen-intro","props":{"slug":"intro"},"type":"screen"},{"id":"path-questions","props":{"description":"Path with the questions screens","name":"questions","stepper":{"label":"{index} / {total}","style":"dashed"}},"type":"path"},{"id":"screen-energy-sleep-mood","props":{"slug":"energy-sleep-mood"},"type":"screen"},{"id":"screen-mind-stress-body","props":{"slug":"mind-stress-body"},"type":"screen"},{"id":"screen-thanks","props":{"slug":"thanks"},"type":"screen"},{"id":"end","type":"end"}],"options":{},"screens":[{"components":[{"componentFamily":"content","props":{"content":"# Mi estado actual, en palabras"},"template":"rich-text"},{"componentFamily":"content","props":{"content":"### Qué busca \n Empezar este cuadernillo mirando de frente cómo estás hoy."},"template":"rich-text"},{"componentFamily":"content","props":{"content":"### Por qué puede servir \n A veces sentimos que estamos mal, bien o más o menos, pero no nos detenemos a mirar qué significa eso en concreto. Este ejercicio propone una primera foto del estado actual del cuerpo y de la vida cotidiana. No para etiquetarte ni para juzgarte, sino para volver más visible cómo te estás sintiendo y desde dónde arrancás."},"template":"rich-text"},{"componentFamily":"content","props":{"content":"### Cómo hacerlo \n Leé cada frase y tildá las opciones que más se parezcan a cómo estás hoy. Podés marcar más de una. Si ninguna te representa del todo, completá \"otro\" con tus propias palabras. La idea es responder con honestidad, sin pensar demasiado y sin buscar la opción perfecta. "},"template":"rich-text"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Empezar"},"template":"button"}],"slug":"intro"},{"components":[{"componentFamily":"content","props":{"content":"## Energía, sueño y estado de ánimo"},"template":"rich-text"},{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"energy","label":"Mi __energía__ últimamente se parece más a ...","options":[{"label":"Una batería bastante cargada","value":"charged-battery"},{"label":"Una batería que arranca bien pero se cae rápido","value":"battery-drops-quickly"},{"label":"Una batería baja casi todo el tiempo","value":"low-battery"},{"label":"Una batería impredecible","value":"unpredictable-battery"},{"label":"Un cuerpo cansado pero pasado de vueltas","value":"tired-overwhelmed-body"},{"label":"Un cuerpo apagado","value":"turned-off-body"},{"label":"Otro","value":"other"}]},"template":"checkboxes"},{"componentFamily":"control","props":{"if":{"dataKey":"$energy","operator":"contains","type":"simple","value":"other"},"then":{"componentFamily":"response","props":{"dataKey":"energy-other","label":"¿Cómo describirías tu energía?"},"template":"text-input"}},"template":"conditional"}],"name":"energy"},"template":"group"},{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"sleep","label":"Mi relación con el __sueño__ últimamente se parece más a…","options":[{"label":"Me cuesta bajar y dormirme","value":"hard-to-fall-asleep"},{"label":"Me duermo, pero me despierto","value":"wake-up-at-night"},{"label":"Duermo muchas horas, pero descanso poco","value":"long-sleep-low-quality"},{"label":"Me acuesto demasiado tarde","value":"go-to-bed-late"},{"label":"Me cuesta sostener horarios","value":"irregular-sleep"},{"label":"Siento que nunca termino de recuperarme","value":"never-rested"},{"label":"Duermo razonablemente bien","value":"reasonably-good-sleep"},{"label":"Otro","value":"other"}]},"template":"checkboxes"},{"componentFamily":"control","props":{"if":{"dataKey":"$sleep","operator":"contains","type":"simple","value":"other"},"then":{"componentFamily":"response","props":{"dataKey":"sleep-other","label":"¿Cómo describirías tu relación con el sueño?"},"template":"text-input"}},"template":"conditional"}],"name":"sleep"},"template":"group"},{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"mood","label":"Mi __estado de ánimo__ últimamente se parece más a…","options":[{"label":"Estable","value":"stable"},{"label":"Sereno","value":"serene"},{"label":"Bueno","value":"good"},{"label":"Expansivo, acelerado o eufórico","value":"expansive-accelerated-euphoric"},{"label":"Cambiante","value":"changing"},{"label":"Apagado","value":"turned-off"},{"label":"Triste","value":"sad"},{"label":"Con poco interés o disfrute","value":"little-interest-enjoyment"},{"label":"Otro","value":"other"}]},"template":"checkboxes"},{"componentFamily":"control","props":{"if":{"dataKey":"$mood","operator":"contains","type":"simple","value":"other"},"then":{"componentFamily":"response","props":{"dataKey":"mood-other","label":"¿Cómo describirías tu estado de ánimo?"},"template":"text-input"}},"template":"conditional"}],"name":"mood"},"template":"group"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente"},"template":"button"}],"slug":"energy-sleep-mood"},{"components":[{"componentFamily":"content","props":{"content":"## Mente, estrés y cuerpo"},"template":"rich-text"},{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"mind","label":"Mi __mente__ últimamente se parece más a…","options":[{"label":"Clara y enfocada","value":"clear-focused"},{"label":"Dispersa","value":"scattered"},{"label":"Acelerada","value":"accelerated"},{"label":"Nublada","value":"cloudy"},{"label":"Rumiativa","value":"ruminative"},{"label":"Lenta o apagada","value":"slow-tur