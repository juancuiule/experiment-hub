ile","question":"Agresivo/a"},{"id":"enthusiastic","question":"Entusiasmado/a"},{"id":"proud","question":"Satisfecho/a consigo mismo/a"},{"id":"irritable","question":"Irritable"},{"id":"alert","question":"Despierto/a"},{"id":"ashamed","question":"Avergonzado/a"},{"id":"inspired","question":"Inspirado/a"},{"id":"nervous","question":"Nervioso/a"},{"id":"determined","question":"Decidido/a"},{"id":"attentive","question":"Concentrado/a"},{"id":"jittery","question":"Agitado/a"},{"id":"active","question":"Activo/a"},{"id":"afraid","question":"Miedoso/a"}]},"template":"for-each"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente"},"template":"button"}],"slug":"panas"},{"components":[{"componentFamily":"content","props":{"content":"### ¿Qué pensaste y sentiste durante el último mes?\n\nMarcá qué pensaste y cómo te sentiste durante el último mes. Recordá, no hay respuestas buenas o malas: todo sirve."},"template":"rich-text"},{"componentFamily":"control","props":{"component":{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"bieps-{{#for-each-bieps.value.id}}","label":"{{#for-each-bieps.value.question}}","options":"%agreement-scale"},"template":"likert-scale"}],"name":"bieps-{{#for-each-bieps.value.id}}"},"template":"group"},"id":"for-each-bieps","type":"static","values":[{"id":"life_purpose","question":"Creo que sé lo que quiero hacer con mi vida."},{"id":"self_acceptance","question":"Si algo me sale mal puedo aceptarlo, admitirlo."},{"id":"future_orientation","question":"Me importa pensar qué haré en el futuro."},{"id":"autonomy_expression","question":"Puedo decir lo que pienso sin mayores problemas."},{"id":"social_bonds","question":"Generalmente le caigo bien a la gente."},{"id":"self_efficacy","question":"Siento que podré lograr las metas que me proponga."},{"id":"social_support","question":"Cuento con personas que me ayudan si lo necesito."},{"id":"autonomy_independence","question":"En general hag