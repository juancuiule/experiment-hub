{"defaultLocale":"es","dictionary":{"es":{"doses":{"high":"Dosis alta","low":"Dosis baja","medium":"Dosis media"},"substances":{"alcohol":"Alcohol","cannabis":"Cannabis","mdma":"MDMA","psilocybin":"Psilocibina"}}},"edges":[{"from":"start","to":"screen-terms","type":"sequential"},{"from":"screen-terms","to":"screen-substance","type":"sequential"},{"from":"screen-substance","to":"screen-dose","type":"sequential"},{"from":"screen-dose","to":"screen-context","type":"sequential"},{"from":"screen-context","to":"screen-photo","type":"sequential"},{"from":"screen-photo","to":"screen-asc-intro","type":"sequential"},{"from":"screen-asc-intro","to":"screen-asc-1","type":"sequential"},{"from":"screen-asc-1","to":"screen-asc-2","type":"sequential"},{"from":"screen-asc-2","to":"screen-asc-3","type":"sequential"},{"from":"screen-asc-3","to":"screen-asc-4","type":"sequential"},{"from":"screen-asc-4","to":"screen-free-text","type":"sequential"},{"from":"screen-free-text","to":"screen-thanks","type":"sequential"},{"from":"screen-thanks","to":"end","type":"sequential"}],"nodes":[{"id":"start","type":"start"},{"id":"screen-terms","props":{"slug":"terms"},"type":"screen"},{"id":"screen-substance","props":{"slug":"substance"},"type":"screen"},{"id":"screen-dose","props":{"slug":"dose"},"type":"screen"},{"id":"screen-context","props":{"slug":"context"},"type":"screen"},{"id":"screen-photo","props":{"slug":"photo"},"type":"screen"},{"id":"screen-asc-intro","props":{"slug":"asc-intro"},"type":"screen"},{"id":"screen-asc-1","props":{"slug":"asc-1"},"type":"screen"},{"id":"screen-asc-2","props":{"slug":"asc-2"},"type":"screen"},{"id":"screen-asc-3","props":{"slug":"asc-3"},"type":"screen"},{"id":"screen-asc-4","props":{"slug":"asc-4"},"type":"screen"},{"id":"screen-free-text","props":{"slug":"free-text"},"type":"screen"},{"id":"screen-thanks","props":{"slug":"thanks"},"type":"screen"},{"id":"end","type":"end"}],"options":{"doses":[{"label":"[[doses.low]]","value":"low"},{"label":"[[doses.medium]]","value":"medium"},{"label":"[[doses.high]]","value":"high"}],"substances":[{"label":"[[substances.cannabis]]","value":"cannabis"},{"label":"[[substances.psilocybin]]","value":"psilocybin"},{"label":"[[substances.alcohol]]","value":"alcohol"},{"label":"[[substances.mdma]]","value":"mdma"}]},"screens":[{"components":[{"componentFamily":"content","props":{"content":"# Altered X Project"},"template":"rich-text"},{"componentFamily":"content","props":{"content":"Este es un esfuerzo para organizar y sistematizar nuestro conocimiento sobre la experiencia subjetiva humana durante diferentes estados de conciencia.\n\nAlgunos de estos estados son muy diferentes de nuestras experiencias ordinarias y distintas personas los experimentan de maneras particulares. Por eso tu participación es muy importante.\n\nEn este experimento nos enfocamos en estados alterados inducidos por cannabis, psilocibina, alcohol y MDMA. Si aceptás participar, te vamos a hacer preguntas sobre una de tus experiencias alteradas. Va a llevar entre 5 y 10 minutos.\n\nToda experiencia que compartas será completamente anónima y todos los datos estarán disponibles abiertamente para investigadores de todo el mundo."},"template":"rich-text"},{"componentFamily":"response","props":{"dataKey":"consent","defaultValue":false,"label":"Acepto participar.","required":true,"shouldBe":true},"template":"single-checkbox"},{"componentFamily":"control","props":{"else":{"componentFamily":"layout","props":{"alignBottom":true,"disabled":true,"text":"Empezar →"},"template":"button"},"if":{"dataKey":"$consent","operator":"eq","type":"simple","value":true},"then":{"componentFamily":"layout","props":{"alignBottom":true,"text":"Empezar →"},"template":"button"}},"template":"conditional"}],"slug":"terms"},{"components":[{"componentFamily":"content","props":{"content":"### Cada experiencia es única\n\nPensá en una vez que hayas tomado cannabis, psilocibina, alcohol o MDMA y visualizá esa experiencia.\n\nConcentrate en una sola experiencia alterada, inducida voluntariamente. Pensá en dónde estabas, cómo fue, los sonidos y olores que te rodeaban.\n\nIntentá revivir la sensación de tu cuerpo y mente entrando en esa experiencia. Una vez que te hayas enfocado en ese momento, podemos continuar."},"template":"rich-text"},{"componentFamily":"response","props":{"dataKey":"substance","label":"La sustancia que tomé fue:","options":"%substances","required":true},"template":"dropdown"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"substance"},{"components":[{"componentFamily":"content","props":{"content":"### Tu experiencia\n\nLa dosis que tomé fue:"},"template":"rich-text"},{"componentFamily":"response","props":{"dataKey":"dose","label":"","options":"%doses","required":true},"template":"radio"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"dose"},{"components":[{"componentFamily":"content","props":{"content":"### [[substances.{{$$substance.substance}}]] / [[doses.{{$$dose.dose}}]]\n\nDescribí el contexto en el que tuviste esta experiencia."},"template":"rich-text"},{"componentFamily":"response","props":{"dataKey":"context","label":"Estaba...","required":false},"template":"text-area"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"context"},{"components":[{"componentFamily":"content","props":{"content":"### [[substances.{{$$substance.substance}}]] / [[doses.{{$$dose.dose}}]]\n\nSi tenés una foto que te recuerde esa experiencia, podés compartirla acá."},"template":"rich-text"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"photo"},{"components":[{"componentFamily":"content","props":{"content":"## ¡Perfecto!\n\nAhora te vamos a hacer una serie de preguntas para que describas lo que experimentaste.\n\nPara cada frase, indicá en qué medida te describe lo que viviste, comparado con tu estado habitual."},"template":"rich-text"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"asc-intro"},{"components":[{"componentFamily":"content","props":{"content":"### [[substances.{{$$substance.substance}}]] / [[doses.{{$$dose.dose}}]]"},"template":"rich-text"},{"componentFamily":"control","props":{"component":{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"asc-{{#for-each-asc-1.value.id}}","label":"{{#for-each-asc-1.value.question}}","maxLabel":"Sí, completamente","minLabel":"No, nada más que lo habitual"},"template":"slider"}],"name":"asc-{{#for-each-asc-1.value.id}}"},"template":"group"},"id":"for-each-asc-1","randomized":true,"type":"static","values":[{"dimension":"anxiety","id":"anxiety_1","question":"Sentí miedo sin poder decir exactamente por qué."},{"dimension":"anxiety","id":"anxiety_2","question":"Me sentí amenazado/a."},{"dimension":"audio_visual_synesthesia","id":"synesthesia_1","question":"Las formas de las cosas parecían cambiar al ritmo de los sonidos y ruidos."},{"dimension":"audio_visual_synesthesia","id":"synesthesia_2","question":"El color de las cosas parecía modificarse con los sonidos y ruidos."},{"dimension":"blissful_state","id":"bliss_1","question":"Experimenté una paz profunda en mí mismo/a."},{"dimension":"blissful_state","id":"bliss_2","question":"Experimenté un amor que todo lo abarcaba."}]},"template":"for-each"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"asc-1"},{"components":[{"componentFamily":"content","props":{"content":"### [[substances.{{$$substance.substance}}]] / [[doses.{{$$dose.dose}}]]"},"template":"rich-text"},{"componentFamily":"control","props":{"component":{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"asc-{{#for-each-asc-2.value.id}}","label":"{{#for-each-asc-2.value.question}}","maxLabel":"Sí, completamente","minLabel":"No, nada más que lo habitual"},"template":"slider"}],"name":"asc-{{#for-each-asc-2.value.id}}"},"template":"group"},"id":"for-each-asc-2","randomized":true,"type":"static","values":[{"dimension":"changed_meaning","id":"meaning_1","question":"Las cosas cotidianas adquirieron un significado especial."},{"dimension":"changed_meaning","id":"meaning_2","question":"Las cosas a mi alrededor tenían un significado extraño para mí."},{"dimension":"complex_imagery","id":"complex_imagery_1","question":"Vi escenas pasar ante mí en la oscuridad total o con los ojos cerrados."},{"dimension":"complex_imagery","id":"complex_imagery_2","question":"Mi imaginación era extremadamente vívida."},{"dimension":"disembodiment","id":"disembodiment_1","question":"Tuve la sensación de no tener cuerpo."},{"dimension":"disembodiment","id":"disembodiment_2","question":"Tuve la sensación de estar fuera de mi cuerpo."}]},"template":"for-each"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"asc-2"},{"components":[{"componentFamily":"content","props":{"content":"### [[substances.{{$$substance.substance}}]] / [[doses.{{$$dose.dose}}]]"},"template":"rich-text"},{"componentFamily":"control","props":{"component":{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"asc-{{#for-each-asc-3.value.id}}","label":"{{#for-each-asc-3.value.question}}","maxLabel":"Sí, completamente","minLabel":"No, nada más que lo habitual"},"template":"slider"}],"name":"asc-{{#for-each-asc-3.value.id}}"},"template":"group"},"id":"for-each-asc-3","randomized":true,"type":"static","values":[{"dimension":"elementary_imagery","id":"elementary_imagery_1","question":"Vi patrones regulares en la oscuridad completa o con los ojos cerrados."},{"dimension":"elementary_imagery","id":"elementary_imagery_2","question":"Vi colores ante mí en la oscuridad total o con los ojos cerrados."},{"dimension":"experience_of_unity","id":"unity_1","question":"Todo parecía unificarse en una sola cosa."},{"dimension":"experience_of_unity","id":"unity_2","question":"Los conflictos y las contradicciones parecían disolverse."},{"dimension":"impaired_control_cognition","id":"impaired_cognition_1","question":"Tuve dificultad para distinguir lo importante de lo que no lo era."},{"dimension":"impaired_control_cognition","id":"impaired_cognition_2","question":"No podía completar un pensamiento; mis pensamientos se desconectaban repetidamente."}]},"template":"for-each"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"asc-3"},{"components":[{"componentFamily":"content","props":{"content":"### [[substances.{{$$substance.substance}}]] / [[doses.{{$$dose.dose}}]]"},"template":"rich-text"},{"componentFamily":"control","props":{"component":{"componentFamily":"layout","props":{"components":[{"componentFamily":"response","props":{"dataKey":"asc-{{#for-each-asc-4.value.id}}","label":"{{#for-each-asc-4.value.question}}","maxLabel":"Sí, completamente","minLabel":"No, nada más que lo habitual"},"template":"slider"}],"name":"asc-{{#for-each-asc-4.value.id}}"},"template":"group"},"id":"for-each-asc-4","randomized":true,"type":"static","values":[{"dimension":"insightfulness","id":"insightfulness_1","question":"Me sentí muy profundo/a."},{"dimension":"insightfulness","id":"insightfulness_2","question":"Obtuve claridad sobre conexiones que antes me desconcertaban."},{"dimension":"spiritual_experience","id":"spiritual_1","question":"Tuve la sensación de estar conectado/a con un poder superior."},{"dimension":"spiritual_experience","id":"spiritual_2","question":"Mi experiencia tuvo aspectos religiosos."}]},"template":"for-each"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Siguiente →"},"template":"button"}],"slug":"asc-4"},{"components":[{"componentFamily":"content","props":{"content":"### [[substances.{{$$substance.substance}}]] / [[doses.{{$$dose.dose}}]]\n\nDescribí libremente tu experiencia con tus propias palabras."},"template":"rich-text"},{"componentFamily":"response","props":{"dataKey":"free-description","label":"Mi experiencia fue...","required":false},"template":"text-area"},{"componentFamily":"layout","props":{"alignBottom":true,"text":"Finalizar →"},"template":"button"},{"componentFamily":"layout","props":{"alignBottom":true,"payload":{"dataKey":"free-description","value":""},"text":"Saltar pregunta"},"template":"button"}],"slug":"free-text"},{"components":[{"componentFamily":"content","props":{"content":"# ¡Gracias por participar!\n\nTus datos fueron registrados. Cuando los resultados estén analizados, vas a poder verlos en [alteredxproject.com](http://www.alteredxproject.com)"},"template":"rich-text"}],"slug":"thanks"}]}