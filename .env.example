# Bearer token gating GET /api/experiments/:slug/export (researcher data pull).
# Required in production — generate with: openssl rand -hex 32
EXPORT_TOKEN=

# HMAC key for server-issued run tokens (POST /api/runs signs runId+experiment;
# checkpoint writes must present the token). Required in production. Rotating
# it invalidates in-flight participants' runs — only rotate between studies.
# Generate with: openssl rand -hex 32
RUN_TOKEN_SECRET=

# Optional comma-separated allowlist of experiment slugs the backend will issue
# runs for. Unset = any well-formed slug. Keep in sync with the EXPERIMENTS
# record in apps/frontend/src/data/experiments/index.ts.
ALLOWED_EXPERIMENTS=

# Cloudflare Tunnel is locally managed: ingress rules live in
# infra/cloudflared/config.yml and the connector authenticates with
# ./.cloudflared/credentials.json — a gitignored copy of
# ~/.cloudflared/<tunnel-id>.json produced by `cloudflared tunnel create`.
# No token env var needed.
